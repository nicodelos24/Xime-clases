{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "../../modules/**/*.ts", "../../modules/**/*.tsx", "../../packages/**/*.ts", "../../packages/**/*.tsx"],
  "exclude": ["../../packages/**/test/**", "../../modules/**/test/**"]
}
